---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const latestPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
---

<BaseLayout title="TheSend" description="记录思考与技术的文字空间">
  <div class="home">
    {latestPost && (
      <section class="featured">
        <span class="section-label">最新</span>
        <article class="featured-post post-card">
          <header class="featured-header">
            {latestPost.data.category && (
              <a href={`/category/${latestPost.data.category}`} class="category" data-astro-prefetch>
                {latestPost.data.category}
              </a>
            )}
            <h1 class="featured-title">
              <a href={`/blog/${latestPost.id}`} data-astro-prefetch>{latestPost.data.title}</a>
            </h1>
            {latestPost.data.description && (
              <p class="featured-desc">{latestPost.data.description}</p>
            )}
          </header>
          <footer class="featured-footer">
            <time datetime={latestPost.data.pubDate.toISOString()}>
              {new Date(latestPost.data.pubDate).toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            {latestPost.data.tags && latestPost.data.tags.length > 0 && (
              <div class="featured-tags">
                {latestPost.data.tags.slice(0, 3).map((tag) => (
                  <a href={`/tag/${tag}`} class="tag" data-astro-prefetch>{tag}</a>
                ))}
              </div>
            )}
          </footer>
        </article>
      </section>
    )}
    
    {otherPosts.length > 0 && (
      <section class="posts">
        <span class="section-label">更多文章</span>
        <div class="posts-list">
          {otherPosts.map((post, index) => (
            <article class="post-item post-card" style={`--delay: ${index * 0.05}s`}>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Date(post.data.pubDate).toLocaleDateString('zh-CN', {
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                {post.data.category && (
                  <span class="separator">·</span>
                  <a href={`/category/${post.data.category}`} class="category-link" data-astro-prefetch>
                    {post.data.category}
                  </a>
                )}
              </div>
              <h2 class="post-title">
                <a href={`/blog/${post.id}`} data-astro-prefetch>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="post-desc">{post.data.description}</p>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  :root {
    --bg-color: #fefefe;
    --sidebar-bg: #fafafa;
    --text-color: #1a1a1a;
    --text-muted: #666666;
    --text-light: #999999;
    --border-color: #e8e8e8;
    --accent-color: #1a1a1a;
    --font-serif: 'Crimson Text', 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --content-max: 700px;
  }

  [data-theme="dark"] {
    --bg-color: #1a1a1a;
    --sidebar-bg: #1e1e1e;
    --text-color: #e8e8e8;
    --text-muted: #a0a0a0;
    --text-light: #666666;
    --border-color: #333333;
    --accent-color: #e8e8e8;
  }

  .home {
    max-width: var(--content-max);
  }

  .section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
    margin-bottom: 1.5rem;
    transition: color 0.3s ease;
  }

  .featured {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    transition: border-color 0.3s ease;
  }

  .featured-post {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .category {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .category:hover {
    color: var(--text-color);
  }

  .featured-title {
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .featured-title a {
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .featured-title a:hover {
    opacity: 0.7;
  }

  .featured-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 90%;
    transition: color 0.3s ease;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-light);
    transition: color 0.3s ease;
  }

  .featured-tags {
    display: flex;
    gap: 0.75rem;
  }

  .tag {
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .tag:hover {
    color: var(--text-color);
  }

  .posts {
    margin-bottom: 3rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-light);
    transition: color 0.3s ease;
  }

  .separator {
    margin: 0 0.25rem;
  }

  .category-link {
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .category-link:hover {
    color: var(--text-color);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .post-title a {
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-title a:hover {
    opacity: 0.7;
  }

  .post-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  @media (max-width: 1024px) {
    .featured-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .home {
      max-width: 100%;
    }

    .section-label {
      margin-bottom: 1rem;
    }

    .featured {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .featured-post {
      gap: 1rem;
    }

    .featured-title {
      font-size: 1.5rem;
      line-height: 1.25;
    }

    .featured-desc {
      font-size: 0.95rem;
      max-width: 100%;
      line-height: 1.6;
    }

    .featured-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.75rem;
    }

    .posts {
      margin-bottom: 1.5rem;
    }

    .posts-list {
      gap: 1.5rem;
    }

    .post-item {
      gap: 0.35rem;
    }

    .post-meta {
      font-size: 0.75rem;
    }

    .post-title {
      font-size: 1.1rem;
      line-height: 1.35;
    }

    .post-desc {
      font-size: 0.9rem;
      line-height: 1.55;
    }
  }

  @media (max-width: 480px) {
    .featured-title {
      font-size: 1.35rem;
    }

    .featured-desc {
      font-size: 0.9rem;
    }

    .post-title {
      font-size: 1.05rem;
    }

    .section-label {
      margin-bottom: 0.875rem;
      font-size: 0.7rem;
    }
  }
</style>