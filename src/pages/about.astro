      margin-bottom: 1.5rem;
    }

    h2 {
      font-size: 1.05rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    ul {
      padding-left: 1.25rem;
    }

    p {
      margin-bottom: 0.875rem;
    }
  }

  /* Small Mobile */
  @media (max-width: 480px) {
    .page-title {
      font-size: 1.5rem;
    }

    .about-content {
      font-size: 0.95rem;
    }

    .lead {
      font-size: 1rem;
    }

    h2 {
      font-size: 1rem;
      margin-top: 1.75rem;
    }
  }
</style>