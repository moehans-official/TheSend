---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site.ts';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, pubDate, updatedDate, category, tags, description, showToc } = post.data;
const wordCount = post.body ? post.body.replace(/\s/g, '').length : 0;
const readingTime = Math.ceil(wordCount / 400);
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout 
  title={`${title} — TheSend`} 
  description={description}
  article={{
    pubDate,
    updatedDate,
    tags,
  }}
  skeleton="full"
>
  <article class="post">
    <header class="post-header">
      {category && (
        <a href={`/category/${category}`} class="post-category" data-astro-prefetch>{category}</a>
      )}
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-description">{description}</p>}
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>
          {new Date(pubDate).toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="meta-separator">·</span>
        <span>{Math.ceil(wordCount / 100)} 百字</span>
        <span class="meta-separator">·</span>
        <span>{readingTime} 分钟阅读</span>
        {updatedDate && (
          <>
            <span class="meta-separator">·</span>
            <span>更新于 {new Date(updatedDate).toLocaleDateString('zh-CN')}</span>
          </>
        )}
      </div>
    </header>
    
    {showToc !== false && tocHeadings.length > 0 && (
      <nav class="toc" aria-label="目录">
        <h2 class="toc-title">目录</h2>
        <ul class="toc-list">
          {tocHeadings.map((heading) => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    
    <div class="post-content" id="post-content">
      <Content />
    </div>
    
    {tags && tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <a href={`/tag/${tag}`} class="tag" data-astro-prefetch>{tag}</a>
        ))}
      </div>
    )}
    
    {/* 版权块 - CC BY-NC-SA 4.0 */}
    <div class="license-block">
      <p class="license-text">
        本文由 <a href={siteConfig.author.github || '#'} class="license-author">{siteConfig.author.name}</a> 创作，采用 
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener noreferrer license" class="license-link">
          CC BY-NC-SA 4.0
        </a> 
        协议许可。
        <button class="license-copy" onclick="copyLink()" aria-label="复制文章链接" title="复制链接">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </p>
    </div>
    
    <footer class="post-footer">
      <a href="/" class="back-link" data-astro-prefetch>← 返回文章列表</a>
    </footer>
  </article>
</BaseLayout>

<script>
  // Add language labels to code blocks
  document.querySelectorAll('#post-content pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (code) {
      const className = code.className || '';
      const match = className.match(/language-(\w+)/);
      if (match) {
        pre.setAttribute('data-language', match[1]);
      }
    }
  });
  
  // Copy article link function
  function copyLink() {
    const url = window.location.href;
    navigator.clipboard.writeText(url).then(() => {
      const btn = document.querySelector('.license-copy');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>已复制';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('copied');
      }, 2000);
    }).catch(err => {
      console.error('Failed to copy:', err);
    });
  }
  
  // Make copyLink available globally
  window.copyLink = copyLink;
</script>

<style>
  :root {
    --bg-color: #fefefe;
    --sidebar-bg: #fafafa;
    --text-color: #1a1a1a;
    --text-muted: #666666;
    --text-light: #999999;
    --border-color: #e8e8e8;
    --accent-color: #1a1a1a;
    --code-bg: #f0f0f0;
    --code-block-bg: #f5f5f5;
    --code-text: #333333;
    --code-border: #e0e0e0;
    --font-serif: 'Crimson Text', 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'SF Mono', Monaco, Inconsolata, 'Fira Code', monospace;
    --content-max: 700px;
  }

  [data-theme="dark"] {
    --bg-color: #1a1a1a;
    --sidebar-bg: #1e1e1e;
    --text-color: #e8e8e8;
    --text-muted: #a0a0a0;
    --text-light: #666666;
    --border-color: #333333;
    --accent-color: #e8e8e8;
    --code-bg: #2a2a2a;
    --code-block-bg: #252525;
    --code-text: #d4d4d4;
    --code-border: #3a3a3a;
  }

  .post {
    max-width: var(--content-max);
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    transition: border-color 0.3s ease;
  }

  .post-category {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .post-category:hover {
    color: var(--text-color);
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    color: var(--text-color);
    transition: color 0.3s ease;
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 90%;
    transition: color 0.3s ease;
  }

  .post-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    transition: color 0.3s ease;
  }

  .meta-separator {
    margin: 0 0.25rem;
    opacity: 0.5;
  }

  .toc {
    margin-bottom: 3rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--sidebar-bg);
    border: 1px solid var(--border-color);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .toc-title {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
    margin-bottom: 0.75rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
  }

  .toc-item.depth-3 {
    padding-left: 1.25rem;
  }

  .toc-item a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: var(--text-color);
  }

  .post-content {
    line-height: 1.75;
    font-size: 1.05rem;
    color: var(--text-color);
    transition: color 0.3s ease;
  }

  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--text-color);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    color: var(--text-color);
    transition: color 0.3s ease;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
    text-align: justify;
    text-justify: inter-ideograph;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(pre) {
    background-color: var(--code-block-bg) !important;
    color: var(--code-text) !important;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
    border-radius: 6px;
    border: 1px solid var(--code-border);
    position: relative;
    -webkit-overflow-scrolling: touch;
  }

  .post-content :global(pre::before) {
    content: attr(data-language);
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    background-color: transparent;
    opacity: 0.7;
  }

  .post-content :global(pre code) {
    background: none !important;
    padding: 0;
    color: var(--code-text) !important;
    font-family: var(--font-mono);
  }

  .post-content :global(:not(pre) > code) {
    background-color: var(--code-bg);
    color: var(--text-color);
    padding: 0.15em 0.4em;
    font-size: 0.85em;
    border-radius: 3px;
    border: 1px solid var(--code-border);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  [data-theme="dark"] .post-content :global(:not(pre) > code) {
    background-color: var(--code-bg);
    color: var(--text-color);
    border-color: var(--code-border);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--text-color);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    font-style: italic;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .post-content :global(a) {
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness 0.2s;
  }

  .post-content :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem 0;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2.5rem 0;
    transition: border-color 0.3s ease;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.75rem;
    text-align: left;
    transition: border-color 0.3s ease;
  }

  .post-content :global(th) {
    background-color: var(--sidebar-bg);
    font-weight: 600;
    font-family: var(--font-sans);
    transition: background-color 0.3s ease;
  }

  .post-content :global(.katex) {
    font-size: 1.05em;
  }

  .post-content :global(.katex-display) {
    margin: 1.5rem 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .post-tags {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 1rem;
    transition: border-color 0.3s ease;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .tag:hover {
    color: var(--text-color);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text-color);
  }
  
  /* CC BY-NC-SA 4.0 License Block - Minimal */
  .license-block {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    transition: border-color 0.3s ease;
  }
  
  .license-text {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-light);
    line-height: 1.6;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s ease;
  }
  
  .license-text a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
    transition: color 0.2s;
  }
  
  .license-text a:hover {
    color: var(--text-color);
  }
  
  .license-author {
    font-weight: 500;
  }
  
  .license-link {
    white-space: nowrap;
  }
  
  .license-copy {
    background: none;
    border: none;
    padding: 0.25rem;
    margin-left: 0.25rem;
    cursor: pointer;
    color: var(--text-light);
    opacity: 0.6;
    transition: opacity 0.2s, color 0.2s;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }
  
  .license-copy:hover {
    opacity: 1;
    color: var(--text-color);
  }
  
  .license-copy.copied {
    color: #22c55e;
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .post-title {
      font-size: 2rem;
    }

    .post-content :global(h2) {
      font-size: 1.3rem;
    }
  }

  @media (max-width: 768px) {
    .post {
      max-width: 100%;
    }

    .post-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
    }

    .post-title {
      font-size: 1.65rem;
      line-height: 1.2;
    }

    .post-description {
      font-size: 1rem;
      max-width: 100%;
    }

    .post-meta {
      font-size: 0.75rem;
      gap: 0.35rem;
    }

    .toc {
      margin-bottom: 1.5rem;
      padding: 1rem;
    }

    .post-content {
      font-size: 1rem;
      line-height: 1.7;
    }

    .post-content :global(h2) {
      font-size: 1.25rem;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    .post-content :global(h3) {
      font-size: 1.1rem;
      margin-top: 1.5rem;
      margin-bottom: 0.625rem;
    }

    .post-content :global(pre) {
      padding: 1rem;
      font-size: 0.85rem;
      border-radius: 4px;
      margin-left: -1rem;
      margin-right: -1rem;
      border-left: 1px solid var(--code-border);
      border-right: 1px solid var(--code-border);
      border-radius: 0;
    }

    .post-content :global(pre::before) {
      top: 0.35rem;
      right: 0.5rem;
      font-size: 0.6rem;
    }

    .post-content :global(blockquote) {
      padding-left: 1rem;
      margin-left: -1rem;
      border-left-width: 2px;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      padding-left: 1.25rem;
    }

    .post-content :global(li) {
      margin-bottom: 0.35rem;
    }

    .post-content :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .post-tags {
      margin-top: 2rem;
      padding-top: 1rem;
    }
  }

  @media (max-width: 480px) {
    .post-title {
      font-size: 1.5rem;
    }

    .post-description {
      font-size: 0.95rem;
    }

    .post-content {
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .post-content :global(h2) {
      font-size: 1.2rem;
    }

    .post-content :global(h3) {
      font-size: 1.05rem;
    }

    .post-content :global(pre) {
      font-size: 0.8rem;
      padding: 0.875rem;
    }

    .post-content :global(:not(pre) > code) {
      font-size: 0.8em;
    }
    
    /* License block mobile */
    .license-block {
      margin-top: 2rem;
      padding-top: 1.25rem;
    }
    
    .license-text {
      font-size: 0.7rem;
      gap: 0.35rem;
    }
  }
</style>